generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Hash bcrypt du mot de passe pour les comptes email/mot de passe.
  // Null si le compte n'a été créé que via un provider OAuth.
  password      String?

  accounts Account[]
  sessions Session[]
  games    GameHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GameHistory {
  id              String   @id @default(cuid())
  userId          String
  playedAt        DateTime @default(now())
  score           Int
  // Nombre de cibles possibles pour le mode/zone/filtre joués. Nullable car
  // les parties enregistrées avant l'ajout de ce champ n'ont pas cette info.
  total           Int?
  // Nombre de clics incorrects. Nullable pour la même raison que `total`.
  errors          Int?
  mode            String
  zone            String
  durationSeconds Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}

// Pool d'anecdotes pré-générées par pays (API Anthropic, en amont, pas en
// direct pendant une partie). `country` utilise la même clé que
// `COUNTRY_INFO`/`COUNTRY_CONTINENT` (nom anglais world-atlas).
model Anecdote {
  id      String @id @default(cuid())
  country String
  text    String @db.Text

  @@index([country])
}
